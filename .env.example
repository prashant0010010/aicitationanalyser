# Copy this file to .env and fill in only what you want. Every value is optional.
# The application runs in full local mode with no keys at all.

# ---- Optional AI enhancement (subtopic suggestions and commentary only; never changes scores)
# Gemini has a free tier in Google AI Studio and is the recommended choice for free use.
GEMINI_API_KEY=YOUR_API_KEY_HERE
OPENAI_API_KEY=YOUR_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
# auto picks the first provider with a real key. Use none to force local-only mode.
AI_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Optional search API (only used to suggest candidate external sources)
# SEARCH_PROVIDER=brave        # brave or google_cse, default none
SEARCH_API_KEY=YOUR_API_KEY_HERE
# SEARCH_ENGINE_ID=YOUR_ENGINE_ID_HERE   # google_cse only

# ---- Semantic engine
# auto uses sentence-transformers if installed, otherwise TF-IDF cosine similarity.
SEMANTIC_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Behaviour
REQUEST_TIMEOUT=15
MAX_CONTENT_CHARS=200000
MAX_DOWNLOAD_BYTES=3000000
MAX_EXTERNAL_SOURCES=15
CACHE_TTL_SECONDS=3600
REPORT_DIR=reports
DEBUG=false
# Only set to true on a private machine if you must analyse intranet pages.
ALLOW_PRIVATE_URLS=false
